<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.8</version>
        <relativePath/>
    </parent>

    <groupId>com.jtzj</groupId>
    <artifactId>ai-agent-java</artifactId>
    <version>1.2.0</version>
    <packaging>pom</packaging>
    <name>ai-agent-java</name>
    <description>Agent task service built on AgentScope Java (multi-module)</description>

    <!--
      Module layout (dependency direction only ever points downward):

        ai-agent-core   shared domain: model, config (AgentProperties), shared services
                        (VisionClient / PdfService / SandboxPaths / ... ) and the tool SPI
                        (AgentToolProvider / ToolContext).  No Spring Boot app, no tools.
        ai-agent-tools  the custom agent tools + one AgentToolProvider each.  Adding or changing
                        a tool touches ONLY this module.  Depends on core (+ AgentScope).
        ai-agent-app    the Spring Boot application: web API, task service, store, orchestration.
                        Depends on tools + core; collects the tool providers at runtime.
    -->
    <modules>
        <module>ai-agent-core</module>
        <module>ai-agent-tools</module>
        <module>ai-agent-app</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <agentscope.version>2.0.3</agentscope.version>
    </properties>

</project>
