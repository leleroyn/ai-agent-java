# Copy to .env and edit. .env is git-ignored; never commit real credentials.
#
#   local run :  scripts/run-local.sh        (loads .env then starts the jar)
#   container :  docker run --env-file .env  (see scripts/docker-run.sh)

# ---------- database ----------
DB_HOST=192.168.2.190
DB_PORT=3306
DB_NAME=agent
DB_USER=root
DB_PASSWORD=change-me

# ---------- model profiles (task 用 model 字段选；未指定用 default-model) ----------
# flash 与 pro 完全独立、无共享属性；具体端点/参数见下方各自 profile 块。
# task 传未知 profile 名会在提交时直接报错（不静默回落）。
AGENT_DEFAULT_MODEL=flash

# ---------- vision model (multimodal, only for the understand_image tool) ----------
# 独立的视觉模型：图片字节只发到此处，绝不进主模型上下文（主模型保持纯文本）。
# 必须是带 mmproj 的真 VL 模型；不带 mmproj 的 llama.cpp 端点会直接回
# "500 image input is not supported ... provide the mmproj"。
AGENT_VISION_ENABLED=true
AGENT_VISION_BASE_URL=http://192.168.1.250:8008/v1
AGENT_VISION_API_KEY=local
AGENT_VISION_MODEL_NAME=qwenvl
# 单次工具调用最多理解几张图（多图会在同一次请求里跨图推理）。
AGENT_VISION_MAX_IMAGES=8
# 单张图下载字节上限（默认 8MB），防被超大文件或非图片地址拖垮。
AGENT_VISION_MAX_IMAGE_BYTES=8388608
AGENT_VISION_TIMEOUT=120
AGENT_VISION_TEMPERATURE=0.0
# 视觉推理强度：none 关闭思考（llama.cpp 走 chat_template_kwargs.enable_thinking；非推理模型会被忽略）。
AGENT_VISION_REASONING_EFFORT=none
# ---------- flash profile（默认；llama.cpp :8007 minicpm，实测 n_ctx=8192、slots=1，宜短任务）----------
AGENT_FLASH_BASE_URL=http://192.168.1.250:8007/v1
AGENT_FLASH_API_KEY=local
AGENT_FLASH_MODEL_NAME=minicpm
AGENT_FLASH_NATIVE_SO=true
AGENT_FLASH_NATIVE_SO_WITH_TOOLS=false
AGENT_FLASH_STRUCTURED_OUTPUT=two_phase
AGENT_FLASH_REASONING_EFFORT=none
AGENT_FLASH_MAX_TOKENS=2048
AGENT_FLASH_TEMPERATURE=0.6
AGENT_FLASH_CONTEXT_WINDOW=8192

# ---------- pro profile（task 传 model:"pro"；llama.cpp :8009 qwen，n_ctx=200192）----------
AGENT_PRO_BASE_URL=http://192.168.1.250:8009/v1
AGENT_PRO_API_KEY=local
AGENT_PRO_MODEL_NAME=qwen
# llama.cpp 同时发 tools+json_schema 会 400，故 with-tools=false；带图+schema 靠 two_phase。
AGENT_PRO_NATIVE_SO=true
AGENT_PRO_NATIVE_SO_WITH_TOOLS=false
AGENT_PRO_STRUCTURED_OUTPUT=two_phase
AGENT_PRO_REASONING_EFFORT=none
AGENT_PRO_MAX_TOKENS=131072
AGENT_PRO_TEMPERATURE=1.0
AGENT_PRO_CONTEXT_WINDOW=131072

# ---------- agent behaviour ----------
AGENT_MAX_ITERS=20
# RISK: BYPASS + shell tools + no auth = remote command execution.
# Harden with EXPLORE (read-only) or DONT_ASK before exposing the service.
AGENT_PERMISSION_MODE=BYPASS

# ---------- concurrency / queue / timeout ----------
# Worker threads; each claims one task at a time directly from MySQL, so this is the exact
# concurrency. There is no in-memory queue — agent_task is the queue.
AGENT_MAX_CONCURRENT=4
AGENT_DEFAULT_TIMEOUT=120
AGENT_MAX_TIMEOUT=900
# A claim is valid for this long and is renewed while the task runs. If the process is killed,
# the lease lapses and the task returns to the queue instead of being lost.
AGENT_LEASE_SECONDS=90
AGENT_LEASE_REAP_SECONDS=30
# Total claims allowed per task before it is failed with AGENT_LEASE_EXPIRED.
AGENT_MAX_ATTEMPTS=2
# Poll pacing while the queue looks empty (doubles up to the backoff ceiling).
AGENT_POLL_INTERVAL_MS=250
AGENT_POLL_BACKOFF_SECONDS=3
# Refuse new submissions (HTTP 429) beyond this many still-queued tasks; 0 disables the cap.
AGENT_MAX_QUEUED_TASKS=1000

# ---------- tools ----------
AGENT_TOOL_SHELL=true
AGENT_TOOL_READ=true
AGENT_TOOL_WRITE=true
AGENT_TOOL_TODO=true
# 自定义工具：get_system_time（服务器当前时间），默认全局开启。
AGENT_TOOL_SYSTEM_TIME=true
# 四个专职媒体工具，默认全开，走上面的独立视觉模型（图片字节不进主模型上下文）：
#   understand_image / extract_image_fields / understand_pdf / extract_pdf_fields
AGENT_TOOL_IMAGE_UNDERSTAND=true
AGENT_TOOL_IMAGE_EXTRACT=true
AGENT_TOOL_DOCUMENT_UNDERSTAND=true
AGENT_TOOL_DOCUMENT_EXTRACT=true

# ---------- PDF 工具（understand_pdf 自由问答 / extract_pdf_fields 整篇抽取） ----------
# 视觉端点复用上面的 AGENT_VISION_*。extract_pdf_fields 服务端遍历整篇保召回，总结交给主模型。
# 每批交给视觉模型的页数（understand_pdf 单次上限；extract 每批页数）；实际上限 = min(本值, AGENT_VISION_MAX_IMAGES)
AGENT_PDF_PAGES_PER_CALL=6
# extract_pdf_fields 遍历整篇时的并发批数
AGENT_PDF_CONCURRENCY=4
# extract_pdf_fields 服务端最多扫描多少页（兜底；超过只扫前 N 页并标 incomplete）
AGENT_PDF_MAX_PAGES=200
# 栅格化最长边像素（控 token；0=不缩放）
AGENT_PDF_MAX_DIM=1568
AGENT_PDF_JPEG_QUALITY=85
# 单次 VL 调用超时（秒）
AGENT_PDF_TIMEOUT=120
# PDF 下载体积上限（字节）
AGENT_PDF_MAX_DOWNLOAD_BYTES=209715200
# SSRF 主机白名单（后缀匹配，逗号分隔）；留空=允许任意 http/https（与图片工具一致）
# AGENT_PDF_SSRF_ALLOWLIST=internal.example

# ---------- skills ----------
# Reusable skills: <dir>/<skill-name>/SKILL.md with YAML frontmatter (name, description).
# Only name + description go into the prompt; the model pulls the body on demand with
# load_skill_through_path, so unused skills cost almost nothing.
AGENT_SKILLS_ENABLED=true
# Skills packaged inside the jar (src/main/resources/skills); skipped when absent.
AGENT_SKILLS_CLASSPATH=skills
# Operator directory, higher priority than the bundled one (same name overrides). Re-read per
# task by mtime/size, so editing a SKILL.md takes effect without a restart.
AGENT_SKILLS_DIR=./agent-skills
AGENT_SKILLS_LAZY=true
# RISK: allows a skill's scripts to run through the shell tool. Anyone who can write
# AGENT_SKILLS_DIR would then get code execution. Off by default.
AGENT_SKILLS_CODE_EXEC=false
AGENT_SKILLS_MAX_REQUESTED=8
# Skills named in a request are injected into the prompt so they always apply; this caps how
# much of the context they may occupy.
AGENT_SKILLS_MAX_INLINE_CHARS=12000

# 任务工作根目录，每个任务跑在 <AGENT_WORKING_DIR>/<taskId>。
# 本地跑用 ./agent-workspace；容器部署时 scripts/docker-run.sh 与 docker-compose.yml 会
# 显式覆盖为绝对路径 /workspace（挂 named volume），所以这里保持相对值即可。
AGENT_WORKING_DIR=./agent-workspace
# Remove a task directory after it finishes (false keeps files for inspection).
AGENT_DELETE_WORKSPACE_ON_FINISH=false
# Comma-separated shell allowlist; empty means no allowlist (permission mode still applies).
AGENT_SHELL_ALLOWED=

# ---------- input limits ----------
AGENT_LIMIT_INSTRUCTION=32768
AGENT_LIMIT_SCHEMA=8192
AGENT_LIMIT_METADATA=8192
